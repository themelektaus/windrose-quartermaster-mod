.gitignore/
.vs/
.webview2/
bin/
obj/

*.user
desktop.ini
Thumbs.db

# DataRoot state (dev checkout uses the repo root as DataRoot)
/game-install.json
/item-language.json

/.build-tmp/
/.minimax/
/Archive/
/Builds/
/Icons/
/Profiles/
/References/
/Sources/
/Test/
/Testserver/
/Tools/ReportReceiver/publish/
/WindrosePlus/

/ffmpeg.exe
/repak.exe
/retoc.exe

/Detex.dll
/liboodle-data-shared.so
/oo2core_*.dll
/oodle-data-shared.dll

# VS auto-generated, contains user-local ports
GUI/*/Properties/launchSettings.json

# Dumper7 submodule extras: dump output (regenerated per run) + msbuild artifacts
/Tools/Dumper7/x64/
/Tools/Dumper7Setup/output/
/Tools/Dumper7Setup/inject/inject.exe
/Tools/Dumper7Setup/inject/inject.obj

# DllProxy dxgi build artifacts (C++/MSVC output)
/Tools/DllProxy/dxgi/*.obj
/Tools/DllProxy/dxgi/*.dll
/Tools/DllProxy/dxgi/*.exp
/Tools/DllProxy/dxgi/*.lib
/Tools/DllProxy/dxgi/*.res
/Tools/DllProxy/dxgi/qm_version.h
/Tools/DllProxy/dxgi/qm_modtab_layout_default.h
/Tools/DllProxy/dxgi/build.log
/Tools/DllProxy/dxgi/build_out.txt
/Tools/DllProxy/dxgi/_bld.log

/Tools/ghidra_*/
/Tools/re_ghidra/

# Python caches
__pycache__/
*.pyc

# Unreal Engine project artifacts (generated by editor/build)
/Unreal Projects/*/Build/
/Unreal Projects/*/DerivedDataCache/
/Unreal Projects/*/Intermediate/
/Unreal Projects/*/Saved/

*.psd
