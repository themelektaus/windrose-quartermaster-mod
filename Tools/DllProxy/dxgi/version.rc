// Embedded ownership proof: ProductName "Quartermaster" in the PE version
// resource is what GameDeployer / deploy.bat / uninstall.bat check before
// overwriting or deleting a dxgi.dll (the name alone is generic - ReShade
// and other tools ship a dxgi.dll too). Renaming this value breaks them.
// Version numbers come from qm_version.h, generated by build.bat from the
// configurator csproj (the single source of truth for the version).
#include "qm_version.h"
1 VERSIONINFO
FILEVERSION    QM_VERSION_COMMA
PRODUCTVERSION QM_VERSION_COMMA
FILEOS         0x40004L
FILETYPE       0x2L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "TheMelekTaus"
      VALUE "FileDescription",  "Quartermaster mod loader for Windrose (DXGI proxy)"
      VALUE "FileVersion",      QM_VERSION_STR
      VALUE "InternalName",     "Quartermaster"
      VALUE "OriginalFilename", "dxgi.dll"
      VALUE "ProductName",      "Quartermaster"
      VALUE "ProductVersion",   QM_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
